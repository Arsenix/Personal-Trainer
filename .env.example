# Copia este archivo a .env.local y ajusta los valores.
# Base de datos: dos roles distintos (ver db/migrations/001_init.sql).
ADMIN_DATABASE_URL=postgres://ptagenda_admin:admin_dev_pass@localhost:5432/pt_agenda_dev
DATABASE_URL=postgres://ptagenda_app:dev_app_pass@localhost:5432/pt_agenda_dev
AUTH_DATABASE_URL=postgres://ptagenda_auth:dev_auth_pass@localhost:5432/pt_agenda_dev
APP_DB_PASSWORD=dev_app_pass
AUTH_DB_PASSWORD=dev_auth_pass

# Better Auth: genera el secreto con `openssl rand -base64 32`
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-bytes
APP_URL=http://localhost:3000

# Correo (Resend). Sin RESEND_API_KEY los correos se escriben en la consola.
RESEND_API_KEY=
MAIL_FROM=PT Agenda <no-responder@ejemplo.cl>
